root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{kt,kts}]
indent_size = 2
max_line_length = 160

# DTO/entity/reference files bundle several related declarations in one file
ktlint_standard_filename = disabled

[*.{java,xml}]
indent_size = 2

[*.yml]
indent_size = 2

[Makefile]
indent_style = tab
