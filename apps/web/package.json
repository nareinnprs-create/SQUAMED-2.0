{
  "name": "@squamed/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "axe": "node scripts/axe-scan.mjs",
    "lighthouse": "node scripts/lighthouse-budget.mjs",
    "visual-regression": "playwright test --config playwright.visual-regression.config.ts",
    "visual-regression:update": "playwright test --config playwright.visual-regression.config.ts --update-snapshots",
    "clean": "rm -rf .next dist node_modules"
  },
  "dependencies": {
    "@squamed/api-client": "*",
    "@squamed/auth": "*",
    "@squamed/design-system": "*",
    "@squamed/domain-types": "*",
    "@squamed/schemas": "*",
    "@squamed/ui": "*",
    "axios": "^1.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "next": "^15.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "axe-core": "^4.10.0",
    "chrome-launcher": "^1.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^26.1.0",
    "lighthouse": "^12.8.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
