# SQUAMED backend environment (copy to .env and source before running)
# Copy to: backend/squamed-core/.env  (or export per your orchestrator)

# ============================================================
# DEVELOPMENT (default profile; values mirror the local compose)
# ============================================================

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5433/squamed
DB_USERNAME=squamed
DB_PASSWORD=squamed_dev_password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Auth / bootstrap ---
JWT_SECRET=dev-only-secret-key-change-in-production-0123456789abcdef
BOOTSTRAP_ADMIN_EMAIL=admin@squamed.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- OpenSearch ---
OPENSEARCH_URIS=http://localhost:9200
SEARCH_REINDEX_ON_STARTUP=true

# --- STT / AI ---
AI_STT_PROVIDER=echo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WHISPER_MODEL=whisper-1

# ============================================================
# PRODUCTION (used by docker-compose.prod.yml; NEVER reuse
# the development placeholders above in real deployments)
# ============================================================
# SQUAMED_ENV=production
# SQUAMED_IMAGE=ghcr.io/your-org/SQUAMED-2.0-backend:latest
# DB_USERNAME=squamed
# DB_PASSWORD=change-me-to-a-long-random-secret
# JWT_SECRET=generate-with: openssl rand -base64 48
# BOOTSTRAP_ADMIN_EMAIL=ops@example.org
# BOOTSTRAP_ADMIN_PASSWORD=change-me-strong
# CORS_ALLOWED_ORIGINS=https://app.example.org
# REDIS_PASSWORD=change-me-redis
# OPENAI_API_KEY=
# JWT_ACCESS_TTL_MINUTES=15
# JWT_REFRESH_TTL_DAYS=7
# SEARCH_REINDEX_ON_STARTUP=false