{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://squamed.local/schemas/config/approval.schema.json",
  "title": "Approval rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "appliesTo", "approverRole"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "appliesTo": { "type": "string", "minLength": 1 },
          "approverRole": { "type": "string", "minLength": 1 },
          "thresholdAmount": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
