{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://squamed.local/schemas/config/task-sla.schema.json",
  "title": "Task SLA and escalation rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "slaHours"],
        "properties": {
          "priority": { "type": "string", "minLength": 1 },
          "slaHours": { "type": "number", "minimum": 0 },
          "escalateToRole": { "type": "string", "minLength": 1 }
        }
      }
    },
    "defaultSlaHours": { "type": "number", "minimum": 0 }
  }
}
