{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://squamed.local/schemas/config/working-hours.schema.json",
  "title": "Hospital working hours",
  "type": "object",
  "additionalProperties": false,
  "required": ["timezone", "days"],
  "properties": {
    "timezone": { "type": "string", "minLength": 1 },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "open", "close"],
        "properties": {
          "day": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
          "open": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "close": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "closed": { "type": "boolean" }
        }
      }
    }
  }
}
