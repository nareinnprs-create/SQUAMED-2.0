{
  "name": "@squamed/api-client",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "codegen": "openapi-typescript ../../docs/contracts/openapi-v1.json -o src/generated/schema.d.ts && node ./scripts/stamp-schema.mjs",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@squamed/domain-types": "*",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "eslint": "^9.0.0"
  }
}
